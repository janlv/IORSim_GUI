# This file is used to define attributes for paths in the repository.
# It can be used to control how Git handles line endings, merges, and other behaviors.

# Exclude generated version file from export
# This file is generated by the build process and should not be included in source exports.
src/_version.py export-ignore

# Keep line endings consistent across platforms
# Use LF for text files to ensure consistency in repositories
*.py text eol=lf

# Make sure TOML, Markdown, and configuration files use LF line endings
*.toml text eol=lf
*.md   text eol=lf
*.cfg  text eol=lf

# Exclude certain files and directories from export
*.swp export-ignore
*.bak export-ignore
tests/* export-ignore
examples/* export-ignore

# exclude .gitignore etc. from source zip-file
.git*      export-ignore
# exclude pyinstaller batch scripts
*.bat      export-ignore
# exlude tools
tools/     export-ignore
tools/**   export-ignore
